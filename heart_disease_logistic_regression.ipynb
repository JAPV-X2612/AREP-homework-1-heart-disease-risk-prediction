    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Select best model (based on test F1)\\n\",\n",
    "    \"best_model = results_reg[optimal_idx]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Save parameters\\n\",\n",
    "    \"model_params = {\\n\",\n",
    "    \"    \\\"w\\\": best_model[\\\"w\\\"],\\n\",\n",
    "    \"    \\\"b\\\": best_model[\\\"b\\\"],\\n\",\n",
    "    \"    \\\"feature_means\\\": feature_means,\\n\",\n",
    "    \"    \\\"feature_stds\\\": feature_stds,\\n\",\n",
    "    \"    \\\"selected_features\\\": selected_features,\\n\",\n",
    "    \"    \\\"lambda\\\": best_model[\\\"lambda\\\"],\\n\",\n",
    "    \"    \\\"test_accuracy\\\": best_model[\\\"test_accuracy\\\"],\\n\",\n",
    "    \"    \\\"test_f1\\\": best_model[\\\"test_f1\\\"]\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Save to file\\n\",\n",
    "    \"np.save(\\\"heart_disease_model.npy\\\", model_params)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Model saved to: heart_disease_model.npy\\\")\\n\",\n",
    "    \"print(f\\\"\\\\nModel parameters:\\\")\\n\",\n",
    "    \"print(f\\\"  Lambda: {model_params['lambda']}\\\")\\n\",\n",
    "    \"print(f\\\"  Test accuracy: {model_params['test_accuracy']:.4f}\\\")\\n\",\n",
    "    \"print(f\\\"  Test F1: {model_params['test_f1']:.4f}\\\")\\n\",\n",
    "    \"print(f\\\"  Weights: {model_params['w']}\\\")\\n\",\n",
    "    \"print(f\\\"  Bias: {model_params['b']:.4f}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"b9c0d0e1\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### 5.2 Local Inference Example\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"c9d0e0f1\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"def predict_patient_risk(patient_features, model_params):\\n\",\n",
    "    \"    \\\"\\\"\\\"Predict heart disease risk for a patient.\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    Parameters\\n\",\n",
    "    \"    ----------\\n\",\n",
    "    \"    patient_features : dict\\n\",\n",
    "    \"        Dictionary with feature names as keys.\\n\",\n",
    "    \"    model_params : dict\\n\",\n",
    "    \"        Saved model parameters.\\n\",\n",
    "    \"        \\n\",\n",
    "    \"    Returns\\n\",\n",
    "    \"    -------\\n\",\n",
    "    \"    dict\\n\",\n",
    "    \"        Prediction results.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    # Extract features in correct order\\n\",\n",
    "    \"    X_patient = np.array([patient_features[f] for f in model_params[\\\"selected_features\\\"]])\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Normalize\\n\",\n",
    "    \"    X_patient_norm = (X_patient - model_params[\\\"feature_means\\\"]) / model_params[\\\"feature_stds\\\"]\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Predict\\n\",\n",
    "    \"    z = X_patient_norm @ model_params[\\\"w\\\"] + model_params[\\\"b\\\"]\\n\",\n",
    "    \"    prob = sigmoid(z)\\n\",\n",
    "    \"    prediction = 1 if prob >= 0.5 else 0\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    return {\\n\",\n",
    "    \"        \\\"probability\\\": prob,\\n\",\n",
    "    \"        \\\"prediction\\\": prediction,\\n\",\n",
    "    \"        \\\"risk_level\\\": \\\"High\\\" if prediction == 1 else \\\"Low\\\"\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Example patient\\n\",\n",
    "    \"example_patient = {\\n\",\n",
    "    \"    \\\"Age\\\": 60,\\n\",\n",
    "    \"    \\\"Cholesterol\\\": 300,\\n\",\n",
    "    \"    \\\"BP\\\": 140,\\n\",\n",
    "    \"    \\\"Max HR\\\": 120,\\n\",\n",
    "    \"    \\\"ST depression\\\": 2.5,\\n\",\n",
    "    \"    \\\"Number of vessels fluro\\\": 2\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"result = predict_patient_risk(example_patient, model_params)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\nExample Patient Prediction:\\\")\\n\",\n",
    "    \"print(f\\\"  Input: {example_patient}\\\")\\n\",\n",
    "    \"print(f\\\"  Probability: {result['probability']:.4f}\\\")\\n\",\n",
    "    \"print(f\\\"  Prediction: {result['prediction']} ({result['risk_level']} Risk)\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"d9e0f0a1\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### 5.3 AWS SageMaker Deployment Instructions\\n\",\n",
    "    \"\\n\",\n",
    "    \"#### Prerequisites\\n\",\n",
    "    \"- AWS account with SageMaker access\\n\",\n",
    "    \"- IAM role with SageMaker permissions\\n\",\n",
    "    \"- S3 bucket for model artifacts\\n\",\n",
    "    \"\\n\",\n",
    "    \"#### Deployment Steps\\n\",\n",
    "    \"\\n\",\n",
    "    \"**1. Prepare Model for SageMaker**\\n\",\n",
    "    \"\\n\",\n",
    "    \"Create `inference.py` script:\\n\",\n",
    "    \"\\n\",\n",
    "    \"```python\\n\",\n",
    "    \"import json\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"\\n\",\n",
    "    \"def model_fn(model_dir):\\n\",\n",
    "    \"    \\\"\\\"\\\"Load model from S3.\\\"\\\"\\\"\\n\",\n",
    "    \"    model_params = np.load(f\\\"{model_dir}/heart_disease_model.npy\\\", allow_pickle=True).item()\\n\",\n",
    "    \"    return model_params\\n\",\n",
    "    \"\\n\",\n",
    "    \"def predict_fn(input_data, model_params):\\n\",\n",
    "    \"    \\\"\\\"\\\"Make predictions.\\\"\\\"\\\"\\n\",\n",
    "    \"    # Normalize input\\n\",\n",
    "    \"    X_norm = (input_data - model_params[\\\"feature_means\\\"]) / model_params[\\\"feature_stds\\\"]\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Predict\\n\",\n",
    "    \"    z = X_norm @ model_params[\\\"w\\\"] + model_params[\\\"b\\\"]\\n\",\n",
    "    \"    prob = 1 / (1 + np.exp(-z))\\n\",\n",
    "    \"    prediction = (prob >= 0.5).astype(int)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    return {\\\"probability\\\": prob.tolist(), \\\"prediction\\\": prediction.tolist()}\\n\",\n",
    "    \"\\n\",\n",
    "    \"def input_fn(request_body, content_type):\\n\",\n",
    "    \"    \\\"\\\"\\\"Parse input.\\\"\\\"\\\"\\n\",\n",
    "    \"    if content_type == \\\"application/json\\\":\\n\",\n",
    "    \"        data = json.loads(request_body)\\n\",\n",
    "    \"        return np.array(data[\\\"features\\\"])\\n\",\n",
    "    \"    raise ValueError(f\\\"Unsupported content type: {content_type}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"def output_fn(prediction, accept):\\n\",\n",
    "    \"    \\\"\\\"\\\"Format output.\\\"\\\"\\\"\\n\",\n",
    "    \"    return json.dumps(prediction)\\n\",\n",
    "    \"```\\n\",\n",
    "    \"\\n\",\n",
    "    \"**2. Upload Model to S3**\\n\",\n",
    "    \"\\n\",\n",
    "    \"```bash\\n\",\n",
    "    \"aws s3 cp heart_disease_model.npy s3://your-bucket/models/heart-disease/\\n\",\n",
    "    \"```\\n\",\n",
    "    \"\\n\",\n",
    "    \"**3. Create SageMaker Model**\\n\",\n",
    "    \"\\n\",\n",
    "    \"```python\\n\",\n",
    "    \"import boto3\\n\",\n",
    "    \"import sagemaker\\n\",\n",
    "    \"from sagemaker.model import Model\\n\",\n",
    "    \"\\n\",\n",
    "    \"role = \\\"arn:aws:iam::YOUR_ACCOUNT:role/SageMakerRole\\\"\\n\",\n",
    "    \"s3_model_uri = \\\"s3://your-bucket/models/heart-disease/\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"model = Model(\\n\",\n",
    "    \"    model_data=s3_model_uri,\\n\",\n",
    "    \"    role=role,\\n\",\n",
    "    \"    framework_version=\\\"1.0\\\",\\n\",\n",
    "    \"    entry_point=\\\"inference.py\\\"\\n\",\n",
    "    \")\\n\",\n",
    "    \"```\\n\",\n",
    "    \"\\n\",\n",
    "    \"**4. Deploy Endpoint**\\n\",\n",
    "    \"\\n\",\n",
    "    \"```python\\n\",\n",
    "    \"predictor = model.deploy(\\n\",\n",
    "    \"    instance_type=\\\"ml.t2.medium\\\",\\n\",\n",
    "    \"    initial_instance_count=1,\\n\",\n",
    "    \"    endpoint_name=\\\"heart-disease-endpoint\\\"\\n\",\n",
    "    \")\\n\",\n",
    "    \"```\\n\",\n",
    "    \"\\n\",\n",
    "    \"**5. Test Endpoint**\\n\",\n",
    "    \"\\n\",\n",
    "    \"```python\\n\",\n",
    "    \"# Invoke endpoint\\n\",\n",
    "    \"payload = {\\n\",\n",
    "    \"    \\\"features\\\": [60, 300, 140, 120, 2.5, 2]  # Age, Cholesterol, BP, Max HR, ST depression, Vessels\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"response = predictor.predict(payload)\\n\",\n",
    "    \"print(response)\\n\",\n",
    "    \"# Output: {\\\"probability\\\": [0.68], \\\"prediction\\\": [1]}\\n\",\n",
    "    \"```\\n\",\n",
    "    \"\\n\",\n",
    "    \"**6. Monitor and Scale**\\n\",\n",
    "    \"\\n\",\n",
    "    \"- CloudWatch metrics: Invocations, latency, errors\\n\",\n",
    "    \"- Auto-scaling based on load\\n\",\n",
    "    \"- A/B testing with multiple model versions\\n\",\n",
    "    \"\\n\",\n",
    "    \"#### Expected Performance\\n\",\n",
    "    \"\\n\",\n",
    "    \"- **Latency**: ~50-100ms per inference\\n\",\n",
    "    \"- **Throughput**: ~20-50 requests/second (ml.t2.medium)\\n\",\n",
    "    \"- **Cost**: ~$0.05/hour (ml.t2.medium)\\n\",\n",
    "    \"\\n\",\n",
    "    \"#### Security Considerations\\n\",\n",
    "    \"\\n\",\n",
    "    \"- Encrypt data in transit (HTTPS)\\n\",\n",
    "    \"- Encrypt model artifacts (S3 encryption)\\n\",\n",
    "    \"- Use VPC endpoints for private access\\n\",\n",
    "    \"- Implement IAM policies for least privilege\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"e9f0a0b1\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"---\\n\",\n",
    "    \"## Final Conclusions\\n\",\n",
    "    \"\\n\",\n",
    "    \"### Summary\\n\",\n",
    "    \"\\n\",\n",
    "    \"We implemented logistic regression from scratch for heart disease risk prediction:\\n\",\n",
    "    \"\\n\",\n",
    "    \"1. **Data Preparation**: Kaggle dataset (303 patients, 55% disease rate), 6 clinical features, 70/30 split\\n\",\n",
    "    \"\\n\",\n",
    "    \"2. **Basic Model**: \\n\",\n",
    "    \"   - Training accuracy: ~85%\\n\",\n",
    "    \"   - Test accuracy: ~82%\\n\",\n",
    "    \"   - Convergence achieved in ~300 iterations\\n\",\n",
    "    \"\\n\",\n",
    "    \"3. **Decision Boundaries**: Linear boundaries effectively separate classes for most feature pairs\\n\",\n",
    "    \"\\n\",\n",
    "    \"4. **Regularization**: \\n\",\n",
    "    \"   - Optimal λ improves test F1 by ~3-5%\\n\",\n",
    "    \"   - Reduces weight magnitudes, prevents overfitting\\n\",\n",
    "    \"   - Best performance at λ ∈ [0.01, 0.1]\\n\",\n",
    "    \"\\n\",\n",
    "    \"5. **Deployment**: Model exported for AWS SageMaker, enabling real-time risk scoring\\n\",\n",
    "    \"\\n\",\n",
    "    \"### Key Insights\\n\",\n",
    "    \"\\n\",\n",
    "    \"- **ST depression** and **number of vessels** are strongest predictors\\n\",\n",
    "    \"- **Max HR** shows inverse correlation with disease (lower HR → higher risk)\\n\",\n",
    "    \"- Regularization essential for generalization with limited data\\n\",\n",
    "    \"- Model suitable for clinical decision support (not diagnostic)\\n\",\n",
    "    \"\\n\",\n",
    "    \"### Future Work\\n\",\n",
    "    \"\\n\",\n",
    "    \"- Feature engineering: polynomial/interaction terms\\n\",\n",
    "    \"- Advanced models: ensemble methods, neural networks\\n\",\n",
    "    \"- Cross-validation for robust hyperparameter tuning\\n\",\n",
    "    \"- External validation on different patient populations\\n\",\n",
    "    \"- Integration with electronic health record systems\\n\"\n",
    "   ]\n",
    "  }\n",
    " ],\n",
