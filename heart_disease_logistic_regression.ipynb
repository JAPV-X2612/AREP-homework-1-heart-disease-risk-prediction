    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Evaluate\\n\",\n",
    "    \"y_test_pred_pair3, _ = predict(w_pair3, b_pair3, X_test_pair3)\\n\",\n",
    "    \"metrics_pair3 = compute_metrics(y_test, y_test_pred_pair3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Pair 3: {pair3_names[0]} vs {pair3_names[1]}\\\")\\n\",\n",
    "    \"print(f\\\"Test accuracy: {metrics_pair3['accuracy']:.4f}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Plot boundary\\n\",\n",
    "    \"plot_decision_boundary_2d(\\n\",\n",
    "    \"    w_pair3, b_pair3, X_train_pair3, y_train, pair3_names,\\n\",\n",
    "    \"    f\\\"Decision Boundary: {pair3_names[0]} vs {pair3_names[1]}\\\"\\n\",\n",
    "    \")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"b7c8d9e0\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### Discussion: Separability and Non-linearity\\n\",\n",
    "    \"\\n\",\n",
    "    \"- **Pair 1 (Age-Cholesterol)**: Moderate separation; older patients with high cholesterol show higher risk\\n\",\n",
    "    \"- **Pair 2 (BP-Max HR)**: Lower Max HR correlates with disease presence\\n\",\n",
    "    \"- **Pair 3 (ST depression-Vessels)**: Strong separation; higher ST depression and more affected vessels indicate disease\\n\",\n",
    "    \"\\n\",\n",
    "    \"Linear boundaries are reasonable for most pairs, though some non-linearity exists in real physiology.\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"c7d8e9f0\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"---\\n\",\n",
    "    \"## Step 4: Regularization (L2)\\n\",\n",
    "    \"\\n\",\n",
    "    \"### 4.1 Regularized Cost and Gradients\\n\",\n",
    "    \"\\n\",\n",
    "    \"**Regularized cost:**\\n\",\n",
    "    \"\\n\",\n",
    "    \"$$\\n\",\n",
    "    \"J_{\\\\text{reg}}(\\\\vec{w}, b) = J(\\\\vec{w}, b) + \\\\frac{\\\\lambda}{2m} \\\\sum_{j=1}^n w_j^2\\n\",\n",
    "    \"$$\\n\",\n",
    "    \"\\n\",\n",
    "    \"**Regularized gradients:**\\n\",\n",
    "    \"\\n\",\n",
    "    \"$$\\n\",\n",
    "    \"\\\\frac{\\\\partial J_{\\\\text{reg}}}{\\\\partial w_j} = \\\\frac{\\\\partial J}{\\\\partial w_j} + \\\\frac{\\\\lambda}{m} w_j\\n\",\n",
    "    \"$$\\n\",\n",
    "    \"\\n\",\n",
    "    \"$$\\n\",\n",
    "    \"\\\\frac{\\\\partial J_{\\\\text{reg}}}{\\\\partial b} = \\\\frac{\\\\partial J}{\\\\partial b}\\n\",\n",
    "    \"$$\\n\",\n",
    "    \"\\n\",\n",
    "    \"(Note: bias $b$ is **not** regularized)\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"d7e8f9a0\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"def compute_cost_reg(w, b, X, y, lam):\\n\",\n",
    "    \"    \\\"\\\"\\\"Compute regularized logistic regression cost.\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    Parameters\\n\",\n",
    "    \"    ----------\\n\",\n",
    "    \"    w : np.ndarray, shape (n,)\\n\",\n",
    "    \"        Weight vector.\\n\",\n",
    "    \"    b : float\\n\",\n",
    "    \"        Bias term.\\n\",\n",
    "    \"    X : np.ndarray, shape (m, n)\\n\",\n",
    "    \"        Feature matrix.\\n\",\n",
    "    \"    y : np.ndarray, shape (m,)\\n\",\n",
    "    \"        Target vector.\\n\",\n",
    "    \"    lam : float\\n\",\n",
    "    \"        Regularization parameter.\\n\",\n",
    "    \"        \\n\",\n",
    "    \"    Returns\\n\",\n",
    "    \"    -------\\n\",\n",
    "    \"    float\\n\",\n",
    "    \"        Regularized cost J_reg(w, b).\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    m = X.shape[0]\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Base cost\\n\",\n",
    "    \"    base_cost = compute_cost(w, b, X, y)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Regularization term\\n\",\n",
    "    \"    reg_term = (lam / (2 * m)) * np.sum(w ** 2)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    return base_cost + reg_term\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def compute_gradient_reg(w, b, X, y, lam):\\n\",\n",
    "    \"    \\\"\\\"\\\"Compute gradients of regularized cost.\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    Parameters\\n\",\n",
    "    \"    ----------\\n\",\n",
    "    \"    w : np.ndarray, shape (n,)\\n\",\n",
    "    \"        Weight vector.\\n\",\n",
    "    \"    b : float\\n\",\n",
    "    \"        Bias term.\\n\",\n",
    "    \"    X : np.ndarray, shape (m, n)\\n\",\n",
    "    \"        Feature matrix.\\n\",\n",
    "    \"    y : np.ndarray, shape (m,)\\n\",\n",
    "    \"        Target vector.\\n\",\n",
    "    \"    lam : float\\n\",\n",
    "    \"        Regularization parameter.\\n\",\n",
    "    \"        \\n\",\n",
    "    \"    Returns\\n\",\n",
    "    \"    -------\\n\",\n",
    "    \"    dj_dw : np.ndarray, shape (n,)\\n\",\n",
    "    \"        Regularized gradient w.r.t. w.\\n\",\n",
    "    \"    dj_db : float\\n\",\n",
    "    \"        Gradient w.r.t. b (no regularization).\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    m = X.shape[0]\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Base gradients\\n\",\n",
    "    \"    dj_dw, dj_db = compute_gradient(w, b, X, y)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Add regularization to weight gradients\\n\",\n",
    "    \"    dj_dw = dj_dw + (lam / m) * w\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    return dj_dw, dj_db\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def gradient_descent_reg(X, y, w_init, b_init, alpha, lam, num_iters, print_every=100):\\n\",\n",
    "    \"    \\\"\\\"\\\"Run regularized gradient descent.\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    Parameters\\n\",\n",
    "    \"    ----------\\n\",\n",
    "    \"    X : np.ndarray, shape (m, n)\\n\",\n",
    "    \"        Feature matrix.\\n\",\n",
    "    \"    y : np.ndarray, shape (m,)\\n\",\n",
    "    \"        Target vector.\\n\",\n",
    "    \"    w_init : np.ndarray, shape (n,)\\n\",\n",
    "    \"        Initial weights.\\n\",\n",
    "    \"    b_init : float\\n\",\n",
    "    \"        Initial bias.\\n\",\n",
    "    \"    alpha : float\\n\",\n",
    "    \"        Learning rate.\\n\",\n",
    "    \"    lam : float\\n\",\n",
    "    \"        Regularization parameter.\\n\",\n",
    "    \"    num_iters : int\\n\",\n",
    "    \"        Number of iterations.\\n\",\n",
    "    \"    print_every : int\\n\",\n",
    "    \"        Print cost every N iterations (0 = no printing).\\n\",\n",
    "    \"        \\n\",\n",
    "    \"    Returns\\n\",\n",
    "    \"    -------\\n\",\n",
    "    \"    w : np.ndarray, shape (n,)\\n\",\n",
    "    \"        Optimized weights.\\n\",\n",
    "    \"    b : float\\n\",\n",
    "    \"        Optimized bias.\\n\",\n",
    "    \"    J_history : list\\n\",\n",
    "    \"        Cost at each iteration.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    w = w_init.copy()\\n\",\n",
    "    \"    b = b_init\\n\",\n",
    "    \"    J_history = []\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    for i in range(num_iters):\\n\",\n",
    "    \"        dj_dw, dj_db = compute_gradient_reg(w, b, X, y, lam)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        w = w - alpha * dj_dw\\n\",\n",
    "    \"        b = b - alpha * dj_db\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        cost = compute_cost_reg(w, b, X, y, lam)\\n\",\n",
    "    \"        J_history.append(cost)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        if print_every > 0 and (i % print_every == 0 or i == num_iters - 1):\\n\",\n",
    "    \"            print(f\\\"Iteration {i:4d}: Cost = {cost:.4f}, ||w|| = {np.linalg.norm(w):.4f}\\\")\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    return w, b, J_history\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"e7f8a9b0\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### 4.2 Train Models with Different Lambda Values\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"f7a8b9c0\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Lambda values to test\\n\",\n",
    "    \"lambda_values = [0.0, 0.001, 0.01, 0.1, 1.0]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Store results\\n\",\n",
    "    \"results_reg = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"for lam in lambda_values:\\n\",\n",
    "    \"    print(f\\\"\\\\n{'='*60}\\\")\\n\",\n",
    "    \"    print(f\\\"Training with lambda = {lam}\\\")\\n\",\n",
    "    \"    print(f\\\"{'='*60}\\\\n\\\")\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Train model\\n\",\n",
    "    \"    w_reg, b_reg, J_hist_reg = gradient_descent_reg(\\n\",\n",
    "    \"        X_train_norm, y_train, w_init, b_init, alpha, lam, num_iters, print_every=200\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Evaluate on train and test\\n\",\n",
    "    \"    y_train_pred_reg, _ = predict(w_reg, b_reg, X_train_norm)\\n\",\n",
    "    \"    y_test_pred_reg, _ = predict(w_reg, b_reg, X_test_norm)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    train_metrics_reg = compute_metrics(y_train, y_train_pred_reg)\\n\",\n",
    "    \"    test_metrics_reg = compute_metrics(y_test, y_test_pred_reg)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Store results\\n\",\n",
    "    \"    results_reg.append({\\n\",\n",
    "    \"        \\\"lambda\\\": lam,\\n\",\n",
    "    \"        \\\"train_accuracy\\\": train_metrics_reg[\\\"accuracy\\\"],\\n\",\n",
    "    \"        \\\"test_accuracy\\\": test_metrics_reg[\\\"accuracy\\\"],\\n\",\n",
    "    \"        \\\"test_f1\\\": test_metrics_reg[\\\"f1\\\"],\\n\",\n",
    "    \"        \\\"w_norm\\\": np.linalg.norm(w_reg),\\n\",\n",
    "    \"        \\\"final_cost\\\": J_hist_reg[-1],\\n\",\n",
    "    \"        \\\"w\\\": w_reg,\\n\",\n",
    "    \"        \\\"b\\\": b_reg,\\n\",\n",
    "    \"        \\\"J_history\\\": J_hist_reg\\n\",\n",
    "    \"    })\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Results table\\n\",\n",
    "    \"results_df = pd.DataFrame([{\\n\",\n",
    "    \"    \\\"Lambda\\\": r[\\\"lambda\\\"],\\n\",\n",
    "    \"    \\\"Train Acc\\\": r[\\\"train_accuracy\\\"],\\n\",\n",
    "    \"    \\\"Test Acc\\\": r[\\\"test_accuracy\\\"],\\n\",\n",
    "    \"    \\\"Test F1\\\": r[\\\"test_f1\\\"],\\n\",\n",
    "    \"    \\\"||w||\\\": r[\\\"w_norm\\\"],\\n\",\n",
    "    \"    \\\"Final Cost\\\": r[\\\"final_cost\\\"]\\n\",\n",
    "    \"} for r in results_reg])\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\"*80)\\n\",\n",
    "    \"print(\\\"Regularization Results Summary\\\")\\n\",\n",
    "    \"print(\\\"=\\\"*80)\\n\",\n",
    "    \"print(results_df.to_string(index=False))\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"a8b9c0d1\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### 4.3 Compare Cost Convergence\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"b8c9d0e1\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"plt.figure(figsize=(10, 6))\\n\",\n",
    "    \"\\n\",\n",
    "    \"for r in results_reg:\\n\",\n",
    "    \"    plt.plot(r[\\\"J_history\\\"], label=f\\\"λ = {r['lambda']}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.title(\\\"Cost vs Iterations (Regularization Comparison)\\\")\\n\",\n",
    "    \"plt.xlabel(\\\"Iteration\\\")\\n\",\n",
    "    \"plt.ylabel(\\\"Cost J_reg(w, b)\\\")\\n\",\n",
    "    \"plt.legend()\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"c8d9e0f1\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### 4.4 Compare Decision Boundaries (Pair 1: Unregularized vs Regularized)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"d8e9f0a1\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Select optimal lambda (based on test F1)\\n\",\n",
    "    \"optimal_idx = np.argmax([r[\\\"test_f1\\\"] for r in results_reg])\\n\",\n",
    "    \"optimal_lambda = results_reg[optimal_idx][\\\"lambda\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Optimal lambda: {optimal_lambda}\\\")\\n\",\n",
    "    \"print(f\\\"Test F1 improvement: {results_reg[optimal_idx]['test_f1']:.4f}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Train 2D model with regularization (Pair 1)\\n\",\n",
    "    \"w_pair1_reg, b_pair1_reg, _ = gradient_descent_reg(\\n\",\n",
    "    \"    X_train_pair1, y_train, w_init_2d, b_init_2d, alpha=0.01, lam=optimal_lambda, num_iters=1000, print_every=0\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Plot comparison\\n\",\n",
    "    \"fig, axes = plt.subplots(1, 2, figsize=(16, 6))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Unregularized\\n\",\n",
    "    \"x_min, x_max = X_train_pair1[:, 0].min() - 0.5, X_train_pair1[:, 0].max() + 0.5\\n\",\n",
    "    \"y_min, y_max = X_train_pair1[:, 1].min() - 0.5, X_train_pair1[:, 1].max() + 0.5\\n\",\n",
    "    \"xx, yy = np.meshgrid(np.linspace(x_min, x_max, 200), np.linspace(y_min, y_max, 200))\\n\",\n",
    "    \"grid = np.c_[xx.ravel(), yy.ravel()]\\n\",\n",
    "    \"\\n\",\n",
    "    \"z_unreg = grid @ w_pair1 + b_pair1\\n\",\n",
    "    \"probs_unreg = sigmoid(z_unreg).reshape(xx.shape)\\n\",\n",
    "    \"\\n\",\n",
    "    \"axes[0].contourf(xx, yy, probs_unreg, levels=[0, 0.5, 1], alpha=0.3, colors=[\\\"tab:blue\\\", \\\"tab:orange\\\"])\\n\",\n",
    "    \"axes[0].contour(xx, yy, probs_unreg, levels=[0.5], colors=\\\"black\\\", linewidths=2)\\n\",\n",
    "    \"axes[0].scatter(X_train_pair1[y_train == 0, 0], X_train_pair1[y_train == 0, 1], marker=\\\"o\\\", s=50, edgecolors=\\\"k\\\")\\n\",\n",
    "    \"axes[0].scatter(X_train_pair1[y_train == 1, 0], X_train_pair1[y_train == 1, 1], marker=\\\"x\\\", s=50)\\n\",\n",
    "    \"axes[0].set_xlabel(pair1_names[0])\\n\",\n",
    "    \"axes[0].set_ylabel(pair1_names[1])\\n\",\n",
    "    \"axes[0].set_title(\\\"Unregularized (λ = 0)\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Regularized\\n\",\n",
    "    \"z_reg = grid @ w_pair1_reg + b_pair1_reg\\n\",\n",
    "    \"probs_reg = sigmoid(z_reg).reshape(xx.shape)\\n\",\n",
    "    \"\\n\",\n",
    "    \"axes[1].contourf(xx, yy, probs_reg, levels=[0, 0.5, 1], alpha=0.3, colors=[\\\"tab:blue\\\", \\\"tab:orange\\\"])\\n\",\n",
    "    \"axes[1].contour(xx, yy, probs_reg, levels=[0.5], colors=\\\"black\\\", linewidths=2)\\n\",\n",
    "    \"axes[1].scatter(X_train_pair1[y_train == 0, 0], X_train_pair1[y_train == 0, 1], marker=\\\"o\\\", s=50, edgecolors=\\\"k\\\")\\n\",\n",
    "    \"axes[1].scatter(X_train_pair1[y_train == 1, 0], X_train_pair1[y_train == 1, 1], marker=\\\"x\\\", s=50)\\n\",\n",
    "    \"axes[1].set_xlabel(pair1_names[0])\\n\",\n",
    "    \"axes[1].set_ylabel(pair1_names[1])\\n\",\n",
    "    \"axes[1].set_title(f\\\"Regularized (λ = {optimal_lambda})\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"e8f9a0b1\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### Analysis: Regularization Impact\\n\",\n",
    "    \"\\n\",\n",
    "    \"- **Lambda = 0** (no regularization): Risk of overfitting, larger weights\\n\",\n",
    "    \"- **Small lambda** (0.001-0.01): Slight weight shrinkage, improved generalization\\n\",\n",
    "    \"- **Large lambda** (1.0): Strong penalty, potential underfitting\\n\",\n",
    "    \"\\n\",\n",
    "    \"Optimal lambda balances bias-variance tradeoff, improving test performance while controlling model complexity.\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"f8a9b0c1\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
