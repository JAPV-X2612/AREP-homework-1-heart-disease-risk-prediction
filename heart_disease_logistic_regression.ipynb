    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# Heart Disease Risk Prediction\\n\",\n",
    "    \"## Logistic Regression from Scratch\\n\",\n",
    "    \"\\n\",\n",
    "    \"In this notebook we implement **logistic regression** to predict heart disease risk using clinical features.\\n\",\n",
    "    \"\\n\",\n",
    "    \"Dataset: 303 patients from Kaggle UCI repository with 14 features.\\n\",\n",
    "    \"\\n\",\n",
    "    \"We will:\\n\",\n",
    "    \"1. Load and prepare the dataset (EDA, preprocessing, train/test split)\\n\",\n",
    "    \"2. Implement basic logistic regression (sigmoid, cost, gradient descent)\\n\",\n",
    "    \"3. Visualize decision boundaries for feature pairs\\n\",\n",
    "    \"4. Apply L2 regularization and compare models\\n\",\n",
    "    \"5. Export model for AWS SageMaker deployment\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"b1c2d3e4\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Setup\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"c1d2e3f4\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import seaborn as sns\\n\",\n",
    "    \"\\n\",\n",
    "    \"np.random.seed(42)\\n\",\n",
    "    \"plt.rcParams[\\\"figure.figsize\\\"] = (8, 5)\\n\",\n",
    "    \"plt.rcParams[\\\"axes.grid\\\"] = True\\n\",\n",
    "    \"sns.set_style(\\\"whitegrid\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"d1e2f3a4\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"---\\n\",\n",
    "    \"## Step 1: Load and Prepare Dataset\\n\",\n",
    "    \"\\n\",\n",
    "    \"### 1.1 Load Data from Kaggle\\n\",\n",
    "    \"\\n\",\n",
    "    \"Dataset downloaded from: https://www.kaggle.com/datasets/neurocipher/heartdisease\\n\",\n",
    "    \"\\n\",\n",
    "    \"Contains 303 patient records with:\\n\",\n",
    "    \"- **13 clinical features** (age, cholesterol, blood pressure, etc.)\\n\",\n",
    "    \"- **Binary target**: Heart Disease (Presence=1, Absence=0)\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"e1f2a3b4\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Load dataset\\n\",\n",
    "    \"df = pd.read_csv(\\\"heart_disease_prediction.csv\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Dataset shape: {df.shape}\\\")\\n\",\n",
    "    \"print(f\\\"\\\\nColumns: {list(df.columns)}\\\")\\n\",\n",
    "    \"df.head()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"f1a2b3c4\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### 1.2 Exploratory Data Analysis (EDA)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"a2b3c4d5\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Check for missing values\\n\",\n",
    "    \"print(\\\"Missing values per column:\\\")\\n\",\n",
    "    \"print(df.isnull().sum())\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Summary statistics\\n\",\n",
    "    \"print(\\\"\\\\nSummary statistics:\\\")\\n\",\n",
    "    \"df.describe()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"b2c3d4e5\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Binarize target variable\\n\",\n",
    "    \"df[\\\"Heart Disease\\\"] = df[\\\"Heart Disease\\\"].map({\\\"Presence\\\": 1, \\\"Absence\\\": 0})\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Class distribution\\n\",\n",
    "    \"disease_counts = df[\\\"Heart Disease\\\"].value_counts()\\n\",\n",
    "    \"disease_rate = disease_counts[1] / len(df) * 100\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Class distribution:\\\")\\n\",\n",
    "    \"print(disease_counts)\\n\",\n",
    "    \"print(f\\\"\\\\nDisease rate: {disease_rate:.1f}%\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Visualize class distribution\\n\",\n",
    "    \"plt.figure()\\n\",\n",
    "    \"plt.bar([\\\"Absence (0)\\\", \\\"Presence (1)\\\"], disease_counts.values, color=[\\\"tab:blue\\\", \\\"tab:orange\\\"])\\n\",\n",
    "    \"plt.title(\\\"Heart Disease Class Distribution\\\")\\n\",\n",
    "    \"plt.ylabel(\\\"Count\\\")\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"c2d3e4f5\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Check for outliers in key features\\n\",\n",
    "    \"features_to_check = [\\\"Age\\\", \\\"BP\\\", \\\"Cholesterol\\\", \\\"Max HR\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axes = plt.subplots(2, 2, figsize=(12, 8))\\n\",\n",
    "    \"axes = axes.ravel()\\n\",\n",
    "    \"\\n\",\n",
    "    \"for i, col in enumerate(features_to_check):\\n\",\n",
    "    \"    axes[i].boxplot(df[col].dropna())\\n\",\n",
    "    \"    axes[i].set_title(f\\\"{col} Distribution\\\")\\n\",\n",
    "    \"    axes[i].set_ylabel(col)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"d2e3f4a5\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### 1.3 Feature Selection and Preprocessing\\n\",\n",
    "    \"\\n\",\n",
    "    \"We select **6 features** for model training:\\n\",\n",
    "    \"1. `Age` - Patient age (years)\\n\",\n",
    "    \"2. `Cholesterol` - Serum cholesterol (mg/dl)\\n\",\n",
    "    \"3. `BP` - Resting blood pressure (mm Hg)\\n\",\n",
    "    \"4. `Max HR` - Maximum heart rate achieved\\n\",\n",
    "    \"5. `ST depression` - ST depression induced by exercise\\n\",\n",
    "    \"6. `Number of vessels fluro` - Number of major vessels colored by fluoroscopy\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"e2f3a4b5\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Select features\\n\",\n",
    "    \"selected_features = [\\n\",\n",
    "    \"    \\\"Age\\\",\\n\",\n",
    "    \"    \\\"Cholesterol\\\",\\n\",\n",
    "    \"    \\\"BP\\\",\\n\",\n",
    "    \"    \\\"Max HR\\\",\\n\",\n",
    "    \"    \\\"ST depression\\\",\\n\",\n",
    "    \"    \\\"Number of vessels fluro\\\"\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Extract features and target\\n\",\n",
    "    \"X = df[selected_features].values\\n\",\n",
    "    \"y = df[\\\"Heart Disease\\\"].values\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Feature matrix shape: {X.shape}\\\")\\n\",\n",
    "    \"print(f\\\"Target vector shape: {y.shape}\\\")\\n\",\n",
    "    \"print(f\\\"\\\\nFeatures selected: {selected_features}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"f2a3b4c5\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### 1.4 Train/Test Split (70/30, Stratified)\\n\",\n",
    "    \"\\n\",\n",
    "    \"We manually implement stratified split to maintain class proportions.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"a3b4c5d6\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"def stratified_train_test_split(X, y, test_size=0.3, random_state=42):\\n\",\n",
    "    \"    \\\"\\\"\\\"Manual stratified split maintaining class proportions.\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    Parameters\\n\",\n",
    "    \"    ----------\\n\",\n",
    "    \"    X : np.ndarray, shape (m, n)\\n\",\n",
    "    \"        Feature matrix.\\n\",\n",
    "    \"    y : np.ndarray, shape (m,)\\n\",\n",
    "    \"        Target vector.\\n\",\n",
    "    \"    test_size : float\\n\",\n",
    "    \"        Proportion of test set.\\n\",\n",
    "    \"    random_state : int\\n\",\n",
    "    \"        Random seed.\\n\",\n",
    "    \"        \\n\",\n",
    "    \"    Returns\\n\",\n",
    "    \"    -------\\n\",\n",
    "    \"    X_train, X_test, y_train, y_test : np.ndarray\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    np.random.seed(random_state)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Split by class\\n\",\n",
    "    \"    idx_class_0 = np.where(y == 0)[0]\\n\",\n",
    "    \"    idx_class_1 = np.where(y == 1)[0]\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Shuffle indices\\n\",\n",
    "    \"    np.random.shuffle(idx_class_0)\\n\",\n",
    "    \"    np.random.shuffle(idx_class_1)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Split each class\\n\",\n",
    "    \"    n_test_0 = int(len(idx_class_0) * test_size)\\n\",\n",
    "    \"    n_test_1 = int(len(idx_class_1) * test_size)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    test_idx = np.concatenate([\\n\",\n",
    "    \"        idx_class_0[:n_test_0],\\n\",\n",
    "    \"        idx_class_1[:n_test_1]\\n\",\n",
    "    \"    ])\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    train_idx = np.concatenate([\\n\",\n",
    "    \"        idx_class_0[n_test_0:],\\n\",\n",
    "    \"        idx_class_1[n_test_1:]\\n\",\n",
    "    \"    ])\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Shuffle combined indices\\n\",\n",
    "    \"    np.random.shuffle(train_idx)\\n\",\n",
    "    \"    np.random.shuffle(test_idx)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    return X[train_idx], X[test_idx], y[train_idx], y[test_idx]\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"X_train, X_test, y_train, y_test = stratified_train_test_split(X, y, test_size=0.3, random_state=42)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Train set: {X_train.shape[0]} samples\\\")\\n\",\n",
    "    \"print(f\\\"Test set: {X_test.shape[0]} samples\\\")\\n\",\n",
    "    \"print(f\\\"\\\\nTrain disease rate: {y_train.mean() * 100:.1f}%\\\")\\n\",\n",
    "    \"print(f\\\"Test disease rate: {y_test.mean() * 100:.1f}%\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"b3c4d5e6\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### 1.5 Feature Normalization\\n\",\n",
    "    \"\\n\",\n",
    "    \"Standardize features to have mean 0 and standard deviation 1:\\n\",\n",
    "    \"\\n\",\n",
    "    \"$$\\n\",\n",
    "    \"x_j^{(i)} \\\\leftarrow \\\\frac{x_j^{(i)} - \\\\mu_j}{\\\\sigma_j}\\n\",\n",
    "    \"$$\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"c3d4e5f6\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"def normalize_features(X_train, X_test):\\n\",\n",
    "    \"    \\\"\\\"\\\"Standardize features using training set statistics.\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    Parameters\\n\",\n",
    "    \"    ----------\\n\",\n",
    "    \"    X_train : np.ndarray, shape (m_train, n)\\n\",\n",
    "    \"    X_test : np.ndarray, shape (m_test, n)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    Returns\\n\",\n",
    "    \"    -------\\n\",\n",
    "    \"    X_train_norm, X_test_norm : np.ndarray\\n\",\n",
    "    \"        Normalized feature matrices.\\n\",\n",
    "    \"    means, stds : np.ndarray\\n\",\n",
    "    \"        Feature means and standard deviations.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    means = X_train.mean(axis=0)\\n\",\n",
    "    \"    stds = X_train.std(axis=0, ddof=1)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    X_train_norm = (X_train - means) / stds\\n\",\n",
    "    \"    X_test_norm = (X_test - means) / stds\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    return X_train_norm, X_test_norm, means, stds\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"X_train_norm, X_test_norm, feature_means, feature_stds = normalize_features(X_train, X_test)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Normalized feature statistics (train set):\\\")\\n\",\n",
    "    \"print(f\\\"Mean: {X_train_norm.mean(axis=0)}\\\")\\n\",\n",
    "    \"print(f\\\"Std: {X_train_norm.std(axis=0, ddof=1)}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"d3e4f5a6\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### Summary: Data Preparation\\n\",\n",
    "    \"\\n\",\n",
    "    \"- **Source**: Kaggle Heart Disease dataset (303 samples)\\n\",\n",
    "    \"- **Disease rate**: ~55% presence\\n\",\n",
    "    \"- **Features selected**: 6 clinical variables (Age, Cholesterol, BP, Max HR, ST depression, Number of vessels)\\n\",\n",
    "    \"- **Split**: 70% train (212 samples), 30% test (91 samples), stratified\\n\",\n",
    "    \"- **Preprocessing**: Standardization applied\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"e3f4a5b6\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"---\\n\",\n",
    "    \"## Step 2: Implement Basic Logistic Regression\\n\",\n",
    "    \"\\n\",\n",
    "    \"### 2.1 Model Definition\\n\",\n",
    "    \"\\n\",\n",
    "    \"**Hypothesis:**\\n\",\n",
    "    \"\\n\",\n",
    "    \"$$\\n\",\n",
    "    \"f_{\\\\vec{w}, b}(\\\\vec{x}) = \\\\sigma(\\\\vec{w} \\\\cdot \\\\vec{x} + b)\\n\",\n",
    "    \"$$\\n\",\n",
    "    \"\\n\",\n",
    "    \"**Sigmoid function:**\\n\",\n",
    "    \"\\n\",\n",
    "    \"$$\\n\",\n",
    "    \"\\\\sigma(z) = \\\\frac{1}{1 + e^{-z}}\\n\",\n",
    "    \"$$\\n\",\n",
    "    \"\\n\",\n",
    "    \"**Cost function (Binary Cross-Entropy):**\\n\",\n",
    "    \"\\n\",\n",
    "    \"$$\\n\",\n",
    "    \"J(\\\\vec{w}, b) = -\\\\frac{1}{m} \\\\sum_{i=1}^m \\\\left[\\n\",\n",
    "    \"y^{(i)} \\\\log f_{\\\\vec{w}, b}(\\\\vec{x}^{(i)}) +\\n\",\n",
    "    \"(1 - y^{(i)}) \\\\log(1 - f_{\\\\vec{w}, b}(\\\\vec{x}^{(i)}))\\n\",\n",
    "    \"\\\\right]\\n\",\n",
    "    \"$$\\n\",\n",
    "    \"\\n\",\n",
    "    \"**Gradients:**\\n\",\n",
    "    \"\\n\",\n",
    "    \"$$\\n\",\n",
    "    \"\\\\frac{\\\\partial J}{\\\\partial w_j} = \\\\frac{1}{m} \\\\sum_{i=1}^m \\\\left(\\n\",\n",
    "    \"f_{\\\\vec{w}, b}(\\\\vec{x}^{(i)}) - y^{(i)}\\n\",\n",
    "    \"\\\\right) x_j^{(i)}\\n\",\n",
    "    \"$$\\n\",\n",
    "    \"\\n\",\n",
    "    \"$$\\n\",\n",
    "    \"\\\\frac{\\\\partial J}{\\\\partial b} = \\\\frac{1}{m} \\\\sum_{i=1}^m \\\\left(\\n\",\n",
    "    \"f_{\\\\vec{w}, b}(\\\\vec{x}^{(i)}) - y^{(i)}\\n\",\n",
    "    \"\\\\right)\\n\",\n",
    "    \"$$\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"f3a4b5c6\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"def sigmoid(z):\\n\",\n",
    "    \"    \\\"\\\"\\\"Compute sigmoid function.\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    Parameters\\n\",\n",
    "    \"    ----------\\n\",\n",
    "    \"    z : np.ndarray or float\\n\",\n",
    "    \"        Input value(s).\\n\",\n",
    "    \"        \\n\",\n",
    "    \"    Returns\\n\",\n",
    "    \"    -------\\n\",\n",
    "    \"    np.ndarray or float\\n\",\n",
    "    \"        Sigmoid(z).\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    return 1 / (1 + np.exp(-z))\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def compute_cost(w, b, X, y):\\n\",\n",
    "    \"    \\\"\\\"\\\"Compute logistic regression cost (binary cross-entropy).\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    Parameters\\n\",\n",
    "    \"    ----------\\n\",\n",
    "    \"    w : np.ndarray, shape (n,)\\n\",\n",
    "    \"        Weight vector.\\n\",\n",
    "    \"    b : float\\n\",\n",
    "    \"        Bias term.\\n\",\n",
    "    \"    X : np.ndarray, shape (m, n)\\n\",\n",
    "    \"        Feature matrix.\\n\",\n",
    "    \"    y : np.ndarray, shape (m,)\\n\",\n",
    "    \"        Target vector.\\n\",\n",
    "    \"        \\n\",\n",
    "    \"    Returns\\n\",\n",
    "    \"    -------\\n\",\n",
    "    \"    float\\n\",\n",
    "    \"        Cost J(w, b).\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    m = X.shape[0]\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    z = X @ w + b\\n\",\n",
    "    \"    f = sigmoid(z)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Clip to avoid log(0)\\n\",\n",
    "    \"    eps = 1e-8\\n\",\n",
    "    \"    f_clipped = np.clip(f, eps, 1 - eps)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    cost = -(1 / m) * np.sum(\\n\",\n",
    "    \"        y * np.log(f_clipped) + (1 - y) * np.log(1 - f_clipped)\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    return cost\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def compute_gradient(w, b, X, y):\\n\",\n",
    "    \"    \\\"\\\"\\\"Compute gradients of logistic regression cost.\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    Parameters\\n\",\n",
    "    \"    ----------\\n\",\n",
    "    \"    w : np.ndarray, shape (n,)\\n\",\n",
    "    \"        Weight vector.\\n\",\n",
    "    \"    b : float\\n\",\n",
    "    \"        Bias term.\\n\",\n",
    "    \"    X : np.ndarray, shape (m, n)\\n\",\n",
    "    \"        Feature matrix.\\n\",\n",
    "    \"    y : np.ndarray, shape (m,)\\n\",\n",
    "    \"        Target vector.\\n\",\n",
    "    \"        \\n\",\n",
    "    \"    Returns\\n\",\n",
    "    \"    -------\\n\",\n",
    "    \"    dj_dw : np.ndarray, shape (n,)\\n\",\n",
    "    \"        Gradient with respect to w.\\n\",\n",
    "    \"    dj_db : float\\n\",\n",
    "    \"        Gradient with respect to b.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    m = X.shape[0]\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    z = X @ w + b\\n\",\n",
    "    \"    f = sigmoid(z)\\n\",\n",
    "    \"    error = f - y\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    dj_dw = (1 / m) * (X.T @ error)\\n\",\n",
    "    \"    dj_db = (1 / m) * np.sum(error)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    return dj_dw, dj_db\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"a4b5c6d7\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### 2.2 Gradient Descent Implementation\\n\",\n",
    "    \"\\n\",\n",
    "    \"**Update rules:**\\n\",\n",
    "    \"\\n\",\n",
    "    \"$$\\n\",\n",
    "    \"w_j := w_j - \\\\alpha \\\\frac{\\\\partial J}{\\\\partial w_j}\\n\",\n",
    "    \"$$\\n\",\n",
    "    \"\\n\",\n",
    "    \"$$\\n\",\n",
    "    \"b := b - \\\\alpha \\\\frac{\\\\partial J}{\\\\partial b}\\n\",\n",
    "    \"$$\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"b4c5d6e7\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"def gradient_descent(X, y, w_init, b_init, alpha, num_iters, print_every=100):\\n\",\n",
    "    \"    \\\"\\\"\\\"Run gradient descent to optimize w and b.\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    Parameters\\n\",\n",
    "    \"    ----------\\n\",\n",
    "    \"    X : np.ndarray, shape (m, n)\\n\",\n",
    "    \"        Feature matrix.\\n\",\n",
    "    \"    y : np.ndarray, shape (m,)\\n\",\n",
    "    \"        Target vector.\\n\",\n",
    "    \"    w_init : np.ndarray, shape (n,)\\n\",\n",
    "    \"        Initial weights.\\n\",\n",
    "    \"    b_init : float\\n\",\n",
    "    \"        Initial bias.\\n\",\n",
    "    \"    alpha : float\\n\",\n",
    "    \"        Learning rate.\\n\",\n",
    "    \"    num_iters : int\\n\",\n",
    "    \"        Number of iterations.\\n\",\n",
    "    \"    print_every : int\\n\",\n",
    "    \"        Print cost every N iterations (0 = no printing).\\n\",\n",
    "    \"        \\n\",\n",
    "    \"    Returns\\n\",\n",
    "    \"    -------\\n\",\n",
    "    \"    w : np.ndarray, shape (n,)\\n\",\n",
    "    \"        Optimized weights.\\n\",\n",
    "    \"    b : float\\n\",\n",
    "    \"        Optimized bias.\\n\",\n",
    "    \"    J_history : list\\n\",\n",
    "    \"        Cost at each iteration.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    w = w_init.copy()\\n\",\n",
    "    \"    b = b_init\\n\",\n",
    "    \"    J_history = []\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    for i in range(num_iters):\\n\",\n",
    "    \"        dj_dw, dj_db = compute_gradient(w, b, X, y)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        w = w - alpha * dj_dw\\n\",\n",
    "    \"        b = b - alpha * dj_db\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        cost = compute_cost(w, b, X, y)\\n\",\n",
    "    \"        J_history.append(cost)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        if print_every > 0 and (i % print_every == 0 or i == num_iters - 1):\\n\",\n",
    "    \"            print(f\\\"Iteration {i:4d}: Cost = {cost:.4f}\\\")\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    return w, b, J_history\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"c4d5e6f7\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### 2.3 Train Model on Full Feature Set\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"d4e5f6a7\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Initialize parameters\\n\",\n",
    "    \"n_features = X_train_norm.shape[1]\\n\",\n",
    "    \"w_init = np.zeros(n_features)\\n\",\n",
    "    \"b_init = 0.0\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Hyperparameters\\n\",\n",
    "    \"alpha = 0.01\\n\",\n",
    "    \"num_iters = 1000\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Train model\\n\",\n",
    "    \"print(\\\"Training logistic regression model...\\\\n\\\")\\n\",\n",
    "    \"w_trained, b_trained, J_history = gradient_descent(\\n\",\n",
    "    \"    X_train_norm, y_train, w_init, b_init, alpha, num_iters, print_every=100\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"\\\\nFinal parameters:\\\")\\n\",\n",
    "    \"print(f\\\"w = {w_trained}\\\")\\n\",\n",
    "    \"print(f\\\"b = {b_trained:.4f}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"e4f5a6b7\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### 2.4 Cost vs Iterations\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
