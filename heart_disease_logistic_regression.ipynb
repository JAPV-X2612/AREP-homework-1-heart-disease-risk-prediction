    "    \"plot_decision_boundary_2d(\\n\",\n",
    "    \"    w_pair2, b_pair2, X_train_pair2, y_train, pair2_names,\\n\",\n",
    "    \"    f\\\"Decision Boundary: {pair2_names[0]} vs {pair2_names[1]}\\\"\\n\",\n",
    "    \")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"f6a7b8c9\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### 3.3 Pair 3: ST depression vs Number of vessels\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"a7b8c9d0\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Extract features\\n\",\n",
    "    \"pair3_indices = [4, 5]  # ST depression, Number of vessels fluro\\n\",\n",
    "    \"pair3_names = [selected_features[i] for i in pair3_indices]\\n\",\n",
    "    \"\\n\",\n",
