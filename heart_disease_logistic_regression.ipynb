    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"a5b6c7d8\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### 2.5 Predictions and Evaluation\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"b5c6d7e8\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"def predict(w, b, X, threshold=0.5):\\n\",\n",
    "    \"    \\\"\\\"\\\"Make binary predictions using logistic regression model.\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    Parameters\\n\",\n",
    "    \"    ----------\\n\",\n",
    "    \"    w : np.ndarray, shape (n,)\\n\",\n",
    "    \"        Weight vector.\\n\",\n",
    "    \"    b : float\\n\",\n",
    "    \"        Bias term.\\n\",\n",
    "    \"    X : np.ndarray, shape (m, n)\\n\",\n",
    "    \"        Feature matrix.\\n\",\n",
    "    \"    threshold : float\\n\",\n",
    "    \"        Classification threshold.\\n\",\n",
    "    \"        \\n\",\n",
    "    \"    Returns\\n\",\n",
    "    \"    -------\\n\",\n",
    "    \"    predictions : np.ndarray, shape (m,)\\n\",\n",
    "    \"        Binary predictions (0 or 1).\\n\",\n",
    "    \"    probabilities : np.ndarray, shape (m,)\\n\",\n",
    "    \"        Predicted probabilities.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    z = X @ w + b\\n\",\n",
    "    \"    probabilities = sigmoid(z)\\n\",\n",
    "    \"    predictions = (probabilities >= threshold).astype(int)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    return predictions, probabilities\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def compute_metrics(y_true, y_pred):\\n\",\n",
    "    \"    \\\"\\\"\\\"Compute classification metrics.\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    Parameters\\n\",\n",
    "    \"    ----------\\n\",\n",
    "    \"    y_true : np.ndarray, shape (m,)\\n\",\n",
    "    \"        True labels.\\n\",\n",
    "    \"    y_pred : np.ndarray, shape (m,)\\n\",\n",
    "    \"        Predicted labels.\\n\",\n",
    "    \"        \\n\",\n",
    "    \"    Returns\\n\",\n",
    "    \"    -------\\n\",\n",
    "    \"    dict\\n\",\n",
    "    \"        Dictionary with accuracy, precision, recall, F1 score.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    # Confusion matrix elements\\n\",\n",
    "    \"    tp = np.sum((y_true == 1) & (y_pred == 1))\\n\",\n",
    "    \"    tn = np.sum((y_true == 0) & (y_pred == 0))\\n\",\n",
    "    \"    fp = np.sum((y_true == 0) & (y_pred == 1))\\n\",\n",
    "    \"    fn = np.sum((y_true == 1) & (y_pred == 0))\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    accuracy = (tp + tn) / len(y_true)\\n\",\n",
    "    \"    precision = tp / (tp + fp) if (tp + fp) > 0 else 0\\n\",\n",
    "    \"    recall = tp / (tp + fn) if (tp + fn) > 0 else 0\\n\",\n",
    "    \"    f1 = 2 * (precision * recall) / (precision + recall) if (precision + recall) > 0 else 0\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    return {\\n\",\n",
    "    \"        \\\"accuracy\\\": accuracy,\\n\",\n",
    "    \"        \\\"precision\\\": precision,\\n\",\n",
    "    \"        \\\"recall\\\": recall,\\n\",\n",
    "    \"        \\\"f1\\\": f1\\n\",\n",
    "    \"    }\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"c5d6e7f8\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Predictions on train and test sets\\n\",\n",
    "    \"y_train_pred, y_train_prob = predict(w_trained, b_trained, X_train_norm)\\n\",\n",
    "    \"y_test_pred, y_test_prob = predict(w_trained, b_trained, X_test_norm)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Compute metrics\\n\",\n",
    "    \"train_metrics = compute_metrics(y_train, y_train_pred)\\n\",\n",
    "    \"test_metrics = compute_metrics(y_test, y_test_pred)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Display results\\n\",\n",
    "    \"metrics_df = pd.DataFrame({\\n\",\n",
    "    \"    \\\"Train\\\": train_metrics,\\n\",\n",
    "    \"    \\\"Test\\\": test_metrics\\n\",\n",
    "    \"})\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\nModel Performance (Basic Logistic Regression):\\\")\\n\",\n",
    "    \"print(metrics_df.round(4))\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"d5e6f7a8\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### 2.6 Coefficient Interpretation\\n\",\n",
    "    \"\\n\",\n",
