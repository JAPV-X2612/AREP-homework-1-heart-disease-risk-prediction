    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"---\\n\",\n",
    "    \"## Step 3: Visualize Decision Boundaries\\n\",\n",
    "    \"\\n\",\n",
    "    \"We train 2D models on feature pairs to visualize decision boundaries.\\n\",\n",
    "    \"\\n\",\n",
    "    \"**Decision boundary**: Set of points where $f_{\\\\vec{w}, b}(\\\\vec{x}) = 0.5$, i.e., $\\\\vec{w} \\\\cdot \\\\vec{x} + b = 0$.\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"a6b7c8d9\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"def plot_decision_boundary_2d(w, b, X, y, feature_names, title):\\n\",\n",
    "    \"    \\\"\\\"\\\"Plot 2D decision boundary for logistic regression.\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    Parameters\\n\",\n",
    "    \"    ----------\\n\",\n",
    "    \"    w : np.ndarray, shape (2,)\\n\",\n",
    "    \"        Weights for 2 features.\\n\",\n",
    "    \"    b : float\\n\",\n",
    "    \"        Bias term.\\n\",\n",
    "    \"    X : np.ndarray, shape (m, 2)\\n\",\n",
    "    \"        2D feature matrix.\\n\",\n",
    "    \"    y : np.ndarray, shape (m,)\\n\",\n",
    "    \"        Target vector.\\n\",\n",
    "    \"    feature_names : list of str\\n\",\n",
    "    \"        Names of the 2 features.\\n\",\n",
    "    \"    title : str\\n\",\n",
    "    \"        Plot title.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    # Create mesh grid\\n\",\n",
    "    \"    x_min, x_max = X[:, 0].min() - 0.5, X[:, 0].max() + 0.5\\n\",\n",
    "    \"    y_min, y_max = X[:, 1].min() - 0.5, X[:, 1].max() + 0.5\\n\",\n",
    "    \"    xx, yy = np.meshgrid(np.linspace(x_min, x_max, 200),\\n\",\n",
    "    \"                         np.linspace(y_min, y_max, 200))\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Compute probabilities on grid\\n\",\n",
    "    \"    grid = np.c_[xx.ravel(), yy.ravel()]\\n\",\n",
    "    \"    z = grid @ w + b\\n\",\n",
    "    \"    probs = sigmoid(z).reshape(xx.shape)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Plot\\n\",\n",
    "    \"    plt.figure(figsize=(8, 6))\\n\",\n",
    "    \"    plt.contourf(xx, yy, probs, levels=[0, 0.5, 1], alpha=0.3, colors=[\\\"tab:blue\\\", \\\"tab:orange\\\"])\\n\",\n",
    "    \"    plt.contour(xx, yy, probs, levels=[0.5], colors=\\\"black\\\", linewidths=2)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    plt.scatter(X[y == 0, 0], X[y == 0, 1], label=\\\"Absence (0)\\\", marker=\\\"o\\\", s=50, edgecolors=\\\"k\\\")\\n\",\n",
    "    \"    plt.scatter(X[y == 1, 0], X[y == 1, 1], label=\\\"Presence (1)\\\", marker=\\\"x\\\", s=50)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    plt.xlabel(feature_names[0])\\n\",\n",
    "    \"    plt.ylabel(feature_names[1])\\n\",\n",
    "    \"    plt.title(title)\\n\",\n",
    "    \"    plt.legend()\\n\",\n",
    "    \"    plt.show()\"\n",
    "   ]\n",
    "  },\n",
